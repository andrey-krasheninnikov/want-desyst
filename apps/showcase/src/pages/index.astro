---
import '@want-desyst/foundation/styles.css';
import '@want-desyst/foundation/fonts.css';
import '../styles.css';
import logo from '@want-desyst/foundation/assets/wallpapers.svg?url';
import Showcase from '../components/Showcase';
---
<!doctype html>
<html lang="en" dir="ltr">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Want Desyst | UI kit</title><meta name="robots" content="noindex, nofollow" />
<script is:inline>
  let theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  try { const saved = localStorage.getItem('want-theme'); if (saved === 'light' || saved === 'dark') theme = saved; } catch {}
  document.documentElement.dataset.theme = theme;
  document.documentElement.classList.toggle('dark', theme === 'dark');
</script>
</head>
<body><div class="page-background" inert><div></div></div><a href="#main" class="skip-link">Skip to content</a><Showcase logo={logo} client:load /></body>
</html>
